<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_total_brief_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg_dark"
    android:padding="20dp">

    <!-- Faint Wallet Icon on the right -->
    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:layout_alignParentEnd="true"
        android:layout_alignParentTop="true"
        android:layout_marginTop="20dp"
        android:layout_marginEnd="-20dp"
        android:src="@drawable/ic_wallet_faint"
        android:alpha="0.05"
        android:scaleType="fitCenter" />
    
    <!-- Top left: TOTAL BALANCE -->
    <TextView
        android:id="@+id/tv_total_balance_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TOTAL BALANCE"
        android:textColor="#888888"
        android:textSize="10sp"
        android:letterSpacing="0.1"
        android:textStyle="bold" />

    <!-- Top right: NET . JUL 26 -->
    <TextView
        android:id="@+id/tv_date_label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:text="NET • JUL 26"
        android:textColor="#888888"
        android:textSize="10sp"
        android:letterSpacing="0.1"
        android:textStyle="bold" />

    <!-- Main Balance -->
    <TextView
        android:id="@+id/tv_main_balance"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_total_balance_label"
        android:layout_marginTop="12dp"
        android:text="-₹6,376"
        android:textColor="#FF4B4B"
        android:textSize="32sp"
        android:textStyle="bold" />

    <!-- Cycle Indicator -->
    <LinearLayout
        android:id="@+id/ll_cycle_indicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/tv_main_balance"
        android:layout_marginTop="8dp"
        android:orientation="horizontal"
        android:gravity="center_vertical">
        <ImageView
            android:id="@+id/v_cycle_dot"
            android:layout_width="6dp"
            android:layout_height="6dp"
            android:src="@drawable/widget_dot_red" />
        <TextView
            android:id="@+id/tv_cycle_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:text="Net outgoing this cycle"
            android:textColor="#AAAAAA"
            android:textSize="11sp" />
    </LinearLayout>

    <!-- Divider -->
    <ImageView
        android:id="@+id/v_divider"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/ll_cycle_indicator"
        android:layout_marginTop="16dp"
        android:background="#333333" />

    <!-- Bottom Section -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/v_divider"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:baselineAligned="false">

        <!-- IN Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="IN"
                android:textColor="#888888"
                android:textSize="10sp"
                android:letterSpacing="0.1"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↘"
                    android:textColor="#34C759"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp" />
                <TextView
                    android:id="@+id/tv_in_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹124"
                    android:textColor="#34C759"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

        <!-- Vertical Divider -->
        <ImageView
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#333333"
            android:layout_marginEnd="16dp" />

        <!-- OUT Column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="OUT"
                android:textColor="#888888"
                android:textSize="10sp"
                android:letterSpacing="0.1"
                android:textStyle="bold" />
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:orientation="horizontal"
                android:gravity="center_vertical">
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="↗"
                    android:textColor="#FF4B4B"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="4dp" />
                <TextView
                    android:id="@+id/tv_out_amount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="₹6,500"
                    android:textColor="#FF4B4B"
                    android:textSize="16sp"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</RelativeLayout>
